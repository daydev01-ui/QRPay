@page "/qrcodes"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@using System.Text.Json

<PageTitle>Códigos QR — QRPayments BCP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Códigos QR</h1>
    <button class="btn btn-primary" @onclick="() => _showForm = true">+ Generar QR</button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-@_messageType">@_message</div>
}

@if (_showForm)
{
    <div class="card mb-4">
        <div class="card-header">Generar nuevo código QR</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Company ID</label>
                    <input class="form-control" @bind="_genForm.CompanyId" placeholder="GUID de empresa" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Monto</label>
                    <input type="number" class="form-control" @bind="_genForm.Amount" step="0.01" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Moneda</label>
                    <input class="form-control" @bind="_genForm.Currency" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Expira (min)</label>
                    <input type="number" class="form-control" @bind="_genForm.ExpiresInMinutes" />
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success me-2" @onclick="GenerateQR">Generar</button>
                <button class="btn btn-secondary" @onclick="() => _showForm = false">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (_lastQR is not null)
{
    <div class="card mb-4 border-success">
        <div class="card-header bg-success text-white">QR generado exitosamente</div>
        <div class="card-body d-flex gap-4 align-items-start">
            @if (!string.IsNullOrEmpty(_lastQR.ImageBase64))
            {
                <img src="data:image/png;base64,@_lastQR.ImageBase64" alt="QR Code" style="width:150px;height:150px;" />
            }
            <div>
                <p><strong>ID:</strong> @_lastQR.Id</p>
                <p><strong>Monto:</strong> @_lastQR.Amount @_lastQR.Currency</p>
                <p><strong>Expira:</strong> @_lastQR.ExpiresAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
                <p><strong>Estado:</strong> <span class="badge bg-success">@_lastQR.Status</span></p>
            </div>
        </div>
    </div>
}

<div class="mb-3">
    <input class="form-control w-auto d-inline" placeholder="Company ID para filtrar" @bind="_filterCompanyId" @bind:event="oninput" />
    <button class="btn btn-outline-secondary ms-2" @onclick="LoadQRCodes">Buscar</button>
</div>

@if (_loading)
{
    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr><th>ID</th><th>Monto</th><th>Moneda</th><th>Estado</th><th>Expira</th><th>Creado</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var q in _qrcodes)
                {
                    <tr>
                        <td><small>@q.Id.ToString()[..8]...</small></td>
                        <td>@q.Amount</td>
                        <td>@q.Currency</td>
                        <td><span class="badge @(q.Status == "Active" ? "bg-success" : "bg-secondary")">@q.Status</span></td>
                        <td>@q.ExpiresAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@q.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (q.Status == "Active")
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DisableQR(q.Id)">Deshabilitar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<QRItem> _qrcodes = new();
    private QRItem? _lastQR = null;
    private bool _loading = false;
    private bool _showForm = false;
    private string _message = "";
    private string _messageType = "info";
    private string _filterCompanyId = "";
    private GenForm _genForm = new();

    private async Task LoadQRCodes()
    {
        if (string.IsNullOrWhiteSpace(_filterCompanyId)) return;
        _loading = true;
        try
        {
            var client = HttpFactory.CreateClient("Gateway");
            var resp = await client.GetAsync($"/api/qrcodes?companyId={_filterCompanyId}");
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                _qrcodes = JsonSerializer.Deserialize<List<QRItem>>(body, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task GenerateQR()
    {
        var client = HttpFactory.CreateClient("Gateway");
        var resp = await client.PostAsJsonAsync("/api/qrcodes", _genForm);
        if (resp.IsSuccessStatusCode)
        {
            var body = await resp.Content.ReadAsStringAsync();
            _lastQR = JsonSerializer.Deserialize<QRItem>(body, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            _message = "QR generado exitosamente.";
            _messageType = "success";
            _showForm = false;
        }
        else
        {
            _message = "Error al generar el QR.";
            _messageType = "danger";
        }
    }

    private async Task DisableQR(Guid id)
    {
        var client = HttpFactory.CreateClient("Gateway");
        var resp = await client.PutAsync($"/api/qrcodes/{id}/disable", null);
        if (resp.IsSuccessStatusCode)
        {
            _message = "QR deshabilitado.";
            _messageType = "success";
            await LoadQRCodes();
        }
    }

    private class GenForm { public string CompanyId { get; set; } = ""; public decimal Amount { get; set; } = 100; public string Currency { get; set; } = "BOB"; public int ExpiresInMinutes { get; set; } = 30; }
    private class QRItem { public Guid Id { get; set; } public string Code { get; set; } = ""; public decimal Amount { get; set; } public string Currency { get; set; } = ""; public Guid CompanyId { get; set; } public string Status { get; set; } = ""; public DateTime ExpiresAt { get; set; } public DateTime CreatedAt { get; set; } public string? ImageBase64 { get; set; } }
}
