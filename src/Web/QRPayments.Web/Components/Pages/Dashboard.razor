@page "/dashboard"
@rendermode InteractiveServer

<PageTitle>Dashboard — QRPayments BCP</PageTitle>

<h1 class="h3 mb-4">Dashboard</h1>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h6 class="card-title">Empresas</h6>
                <p class="card-text display-6">-</p>
                <a href="/companies" class="text-white-50 small">Ver empresas →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h6 class="card-title">Códigos QR Activos</h6>
                <p class="card-text display-6">-</p>
                <a href="/qrcodes" class="text-white-50 small">Ver códigos →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h6 class="card-title">Transacciones Hoy</h6>
                <p class="card-text display-6">-</p>
                <a href="/transactions" class="text-white-50 small">Ver transacciones →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h6 class="card-title">Reportes</h6>
                <p class="card-text display-6">-</p>
                <a href="/reports" class="text-white-50 small">Ver reportes →</a>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 p-3 bg-white rounded shadow-sm">
    <h5>Sistema de Gestión de Cobros QR — BCP</h5>
    <p class="text-muted">Bienvenido al sistema de gestión de cobros mediante códigos QR integrado con la plataforma BCP.</p>
    <div class="row">
        <div class="col-md-4">
            <h6 class="text-primary">Servicios activos</h6>
            <ul class="list-unstyled">
                <li>✓ CompanyService</li>
                <li>✓ UserService</li>
                <li>✓ QRService</li>
                <li>✓ TransactionService</li>
                <li>✓ ReportService</li>
            </ul>
        </div>
        <div class="col-md-4">
            <h6 class="text-primary">Mocks BCP</h6>
            <ul class="list-unstyled">
                <li>✓ MockBCP.AuthService</li>
                <li>✓ MockBCP.QRService</li>
                <li>✓ MockBCP.PaymentService</li>
            </ul>
        </div>
    </div>
</div>
