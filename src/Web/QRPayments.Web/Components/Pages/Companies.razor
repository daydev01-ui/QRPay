@page "/companies"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@using System.Text.Json

<PageTitle>Empresas — QRPayments BCP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Empresas</h1>
    <button class="btn btn-primary" @onclick="ShowCreateForm">+ Nueva empresa</button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-@_messageType alert-dismissible">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = string.Empty"></button>
    </div>
}

@if (_showForm)
{
    <div class="card mb-4">
        <div class="card-header">@(_editId.HasValue ? "Editar empresa" : "Nueva empresa")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="_form.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cuenta BCP</label>
                    <input class="form-control" @bind="_form.BCPAccountNumber" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">RUC</label>
                    <input class="form-control" @bind="_form.RUC" />
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success me-2" @onclick="SaveCompany">Guardar</button>
                <button class="btn btn-secondary" @onclick="CancelForm">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
}
else if (_companies.Count == 0)
{
    <div class="alert alert-info">No hay empresas registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Cuenta BCP</th>
                    <th>RUC</th>
                    <th>Estado</th>
                    <th>Creado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _companies)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.BCPAccountNumber</td>
                        <td>@c.RUC</td>
                        <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                        <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditCompany(c)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCompany(c.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CompanyItem> _companies = new();
    private bool _loading = true;
    private bool _showForm = false;
    private Guid? _editId = null;
    private string _message = "";
    private string _messageType = "info";
    private FormModel _form = new();

    protected override async Task OnInitializedAsync() => await LoadCompanies();

    private async Task LoadCompanies()
    {
        _loading = true;
        try
        {
            var client = HttpFactory.CreateClient("Gateway");
            var resp = await client.GetAsync("/api/companies");
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                _companies = JsonSerializer.Deserialize<List<CompanyItem>>(body, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }
        catch { _companies = new(); }
        finally { _loading = false; }
    }

    private void ShowCreateForm() { _showForm = true; _editId = null; _form = new(); }
    private void EditCompany(CompanyItem c) { _showForm = true; _editId = c.Id; _form = new() { Name = c.Name, BCPAccountNumber = c.BCPAccountNumber, RUC = c.RUC }; }
    private void CancelForm() { _showForm = false; _form = new(); _editId = null; }

    private async Task SaveCompany()
    {
        var client = HttpFactory.CreateClient("Gateway");
        System.Net.Http.HttpResponseMessage resp;
        if (_editId.HasValue)
            resp = await client.PutAsJsonAsync($"/api/companies/{_editId}", _form);
        else
            resp = await client.PostAsJsonAsync("/api/companies", _form);

        if (resp.IsSuccessStatusCode)
        {
            _message = _editId.HasValue ? "Empresa actualizada correctamente." : "Empresa creada correctamente.";
            _messageType = "success";
            CancelForm();
            await LoadCompanies();
        }
        else
        {
            _message = "Error al guardar la empresa.";
            _messageType = "danger";
        }
    }

    private async Task DeleteCompany(Guid id)
    {
        var client = HttpFactory.CreateClient("Gateway");
        var resp = await client.DeleteAsync($"/api/companies/{id}");
        if (resp.IsSuccessStatusCode)
        {
            _message = "Empresa eliminada.";
            _messageType = "success";
            await LoadCompanies();
        }
        else
        {
            _message = "Error al eliminar la empresa.";
            _messageType = "danger";
        }
    }

    private class FormModel { public string Name { get; set; } = ""; public string BCPAccountNumber { get; set; } = ""; public string RUC { get; set; } = ""; }
    private class CompanyItem { public Guid Id { get; set; } public string Name { get; set; } = ""; public string BCPAccountNumber { get; set; } = ""; public string RUC { get; set; } = ""; public string Status { get; set; } = ""; public DateTime CreatedAt { get; set; } }
}
